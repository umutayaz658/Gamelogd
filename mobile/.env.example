# Point at your dev machine's LAN IP, never localhost/127.0.0.1 (that resolves to the
# phone itself under Expo Go, not your dev machine). Find it with `ipconfig` (Windows)
# under your active network adapter.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api

# Production placeholder — set to the real deployed API host once one exists.
# EXPO_PUBLIC_API_URL=https://api.gamelogd.net/api
