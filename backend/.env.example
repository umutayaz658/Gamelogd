# Backend environment variables — copy to backend/.env and fill in.
# Every variable backend/config/settings.py reads is documented here; values below are
# local-development defaults, NOT production values.

# --- Core Django ---
# DEBUG must be 'False' in production (settings.py fails closed on secrets when it is).
DEBUG=True
# Required in production (ImproperlyConfigured without it); any value works locally.
SECRET_KEY=dev-only-insecure-secret-key
# Comma-separated. Production example: gamelogd-production.up.railway.app,api.gamelogd.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Either set DATABASE_URL (takes precedence; used on Railway/docker-compose)...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamelogd
# ...or the discrete DB_* variables:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gamelogd
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Cache / Channels (optional locally; falls back to in-memory) ---
# REDIS_URL=redis://localhost:6379/0
# REDIS_PRIVATE_URL=

# --- Media storage (optional locally; falls back to backend/media/ on disk) ---
# Either the single-URL form...
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the discrete form:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Third-party integrations (each optional; its feature is disabled without it) ---
# STEAM_API_KEY=          # Steam library sync
# GOOGLE_CLIENT_ID=       # Google OAuth login
# MICROSOFT_CLIENT_ID=    # Xbox account linking
# MICROSOFT_CLIENT_SECRET=
# OPENXBL_API_KEY=

# --- Email (verification codes, notifications) ---
# Preferred: Resend API. Without either, emails print to the console locally.
# RESEND_API_KEY=
# ...or classic SMTP:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# SUPPORT_EMAIL=

# --- URLs / cookies ---
# Where the frontend runs; used in emails and OAuth redirects.
FRONTEND_URL=http://localhost:3000
# Production cookie scoping (leave unset locally):
# CSRF_COOKIE_DOMAIN=.gamelogd.net
# AUTH_COOKIE_DOMAIN=.gamelogd.net

# --- Scheduled jobs ---
# Required in production: shared secret for the cron endpoints (trending recompute etc.).
# CRON_SECRET=
